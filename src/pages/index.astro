		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	// Gestion des compteurs du Cas 2
	document.addEventListener("DOMContentLoaded", () => {
		const el = document.getElementById("vehicle-counter");
		if (el) {
			const target = parseInt(el.dataset.target, 10);
			let hasStarted = false;

			const formatNumber = (n) =>
				n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ");

			const startCounter = () => {
				const duration = 2000;
				const start = 0;
				const startTime = performance.now();

				const animate = (now) => {
					const progress = Math.min((now - startTime) / duration, 1);
					const current = Math.floor(
						start + (target - start) * progress,
					);
					el.textContent = formatNumber(current);

					if (progress < 1) {
						requestAnimationFrame(animate);
					} else {
						el.textContent = formatNumber(target);
					}
				};

				requestAnimationFrame(animate);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && !hasStarted) {
							hasStarted = true;
							startCounter();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.3 },
			);

			observer.observe(el);
		}
	});

	document.addEventListener("DOMContentLoaded", () => {
		const el = document.getElementById("hack-time-counter");
		if (el) {
			const target = parseInt(el.dataset.target, 10);
			let hasStarted = false;

			const startCounter = () => {
				const duration = 2000;
				const start = 0;
				const startTime = performance.now();

				const animate = (now) => {
					const progress = Math.min((now - startTime) / duration, 1);
					const current = Math.floor(
						start + (target - start) * progress,
					);
					el.textContent = current;

					if (progress < 1) {
						requestAnimationFrame(animate);
					} else {
						el.textContent = target;
					}
				};

				requestAnimationFrame(animate);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && !hasStarted) {
							hasStarted = true;
							startCounter();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.3 },
			);

			observer.observe(el);
		}
	});

	// Simulation interactive Cas 1 (Apparition séquentielle des vignettes)
	document.addEventListener("DOMContentLoaded", () => {
		const startBtn = document.getElementById("start-sim-btn");
		const resetBtn = document.getElementById("reset-sim");
		const step0 = document.getElementById("sim-step-0");
		const step1 = document.getElementById("sim-step-1");
		const step2 = document.getElementById("sim-step-2");

		if (startBtn && step0 && step1 && step2) {
			startBtn.addEventListener("click", () => {
				step0.classList.add("hidden");
				step1.classList.remove("hidden");

				// Après 1.8 seconde, transition vers l'étape 2 (tableau de bord complet avec 4 vignettes)
				setTimeout(() => {
					step1.classList.add("hidden");
					step2.classList.remove("hidden");
				}, 1800);
			});
		}

		if (resetBtn && step0 && step1 && step2) {
			resetBtn.addEventListener("click", () => {
				step2.classList.add("hidden");
				step1.classList.add("hidden");
				step0.classList.remove("hidden");
			});
		}
	});

	const quizData = [
		{
			question:
				"Combien de temps faut-il pour cloner une clé Tesla à proximité du porte-clé ?",
			options: [
				"Quelques secondes",
				"Quelques minutes",
				"Quelques heures",
				"Quelques jours",
			],
			answer: 0,
		},
		{
			question:
				"Combien de temps faut-il pour cloner une clé Tesla à proximité du véhicule ?",
			options: [
				"Quelques secondes",
				"Quelques minutes",
				"Quelques heures",
				"Quelques jours",
			],
			answer: 0,
		},
		{
			question:
				"Combien de temps faut-il pour cloner une clé Tesla si l’attaquant dispose d’un relais ?",
			options: [
				"Moins d’une seconde",
				"Quelques secondes",
				"Quelques minutes",
				"Quelques heures",
			],
			answer: 1,
		},
		{
			question:
				"Combien de temps faut-il pour cloner une clé Tesla si la clé est laissée dans un sac ?",
			options: [
				"Quelques secondes",
				"Quelques minutes",
				"Quelques heures",
				"Impossible dans ce cas",
			],
			answer: 0,
		},
	];

	let currentQuestion = 0;
	let score = 0;

	const questionEl = document.getElementById("quiz-question");
	const optionsEl = document.getElementById("quiz-options");
	const progressEl = document.getElementById("quiz-progress");

	function loadQuestion() {
		if (!questionEl || !optionsEl || !progressEl) return;
		const q = quizData[currentQuestion];

		questionEl.textContent = q.question;
		progressEl.textContent = `${currentQuestion + 1} / ${quizData.length}`;

		optionsEl.innerHTML = "";

		q.options.forEach((opt, index) => {
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = `flex flex-row justify-center items-center py-2.5 px-4 gap-[10px] w-full max-w-[540px] h-[50px] bg-[rgba(255,255,255,0.25)] shadow-[0px_12px_30px_rgba(6,27,43,0.08),inset_0px_1px_0px_rgba(255,255,255,0.86)] rounded-[20px] border-none font-sans font-normal text-[17px] leading-snug text-[#107AA5] cursor-pointer transition-all duration-200 hover:bg-[rgba(255,255,255,0.45)] hover:-translate-y-0.5`;
			btn.textContent = opt;
			btn.onclick = () => selectAnswer(index);
			optionsEl.appendChild(btn);
		});
	}

	function selectAnswer(index) {
		if (index === quizData[currentQuestion].answer) {
			score++;
		}

		currentQuestion++;

		if (currentQuestion < quizData.length) {
			loadQuestion();
		} else {
			showResults();
		}
	}

	function showResults() {
		if (!questionEl || !optionsEl || !progressEl) return;
		questionEl.textContent = "Résultat du quiz";
		optionsEl.innerHTML = "";
		progressEl.textContent = "";

		const result = document.createElement("p");
		result.className = "mt-6 text-white text-[20px] font-bold text-center";
		result.textContent = `Tu as ${score} bonne(s) réponse(s) sur ${quizData.length}.`;

		optionsEl.appendChild(result);
	}

	loadQuestion();
</script>
