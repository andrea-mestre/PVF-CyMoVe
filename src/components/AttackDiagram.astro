---
// MitmVisualizer.astro
---

<div
    class="w-full max-w-4xl mx-auto p-6 bg-slate-950 text-slate-100 rounded-2xl border border-slate-800 shadow-2xl font-sans relative overflow-hidden"
>
    <!-- Effet Glow en arrière-plan -->
    <div
        class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute -bottom-24 -right-24 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Header -->
    <div
        class="relative z-10 flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-slate-800/80"
    >
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span
                    class="inline-block w-2 h-2 rounded-full bg-red-500 animate-ping"
                ></span>
                <p
                    class="text-xs font-mono text-red-400 tracking-wider uppercase font-semibold"
                >
                    Analyse Faille Sécurité (2015)
                </p>
            </div>
            <h3 class="text-2xl font-black tracking-tight text-white">
                BMW ConnectedDrive : Attack Vector
            </h3>
        </div>

        <div class="flex items-center gap-3">
            <button
                id="btn-autoplay"
                class="px-3 py-1.5 text-xs font-mono rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 hover:bg-blue-500/20 transition-all flex items-center gap-2"
            >
                <span id="play-icon">▶</span> Mode Démo
            </button>
            <span
                id="status-badge"
                class="px-3 py-1.5 text-xs font-mono rounded-lg bg-slate-900 text-slate-400 border border-slate-800 shadow-inner"
            >
                1 / 4 — Normal
            </span>
        </div>
    </div>

    <!-- Schema interactif -->
    <div
        class="relative z-10 bg-slate-900/80 rounded-xl p-8 border border-slate-800 backdrop-blur-md overflow-hidden"
    >
        <!-- Lignes SVG & Animations -->
        <svg
            class="absolute inset-0 w-full h-full pointer-events-none"
            stroke-width="2"
            fill="none"
        >
            <!-- Connexion Voiture -> Proxy -->
            <path
                d="M 140 85 L 360 85"
                id="line-car-attacker"
                class="stroke-slate-700 transition-all duration-500"></path>
            <!-- Connexion Proxy -> Serveur -->
            <path
                d="M 440 85 L 660 85"
                stroke="currentColor"
                stroke-dasharray="4 4"
                class="stroke-slate-800"></path>
        </svg>

        <!-- Nœuds de l'architecture -->
        <div
            class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 items-center text-center"
        >
            <!-- Cible : Voiture -->
            <div
                id="node-car"
                class="node-card border-slate-800 bg-slate-950/60 hover:border-slate-700"
            >
                <div
                    id="car-icon-container"
                    class="w-14 h-14 mx-auto mb-3 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 transition-all duration-300"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.8"
                            d="M8 17a2 2 0 100 4 2 2 0 000-4zm8 0a2 2 0 100 4 2 2 0 000-4zm-11-4h14l-1.5-4.5a2 2 0 00-1.9-1.5H8.4a2 2 0 00-1.9 1.5L5 13zm-2 0v4a1 1 0 001 1h1m16-5v4a1 1 0 00-1 1h-1M3 13h18"
                        ></path></svg
                    >
                </div>
                <p
                    class="font-bold text-xs uppercase tracking-wider text-slate-300"
                >
                    Véhicule BMW
                </p>
                <span
                    id="car-state"
                    class="inline-block mt-2 px-2.5 py-0.5 rounded text-[11px] font-mono bg-red-500/10 text-red-400 border border-red-500/20"
                >
                    Verrouillé
                </span>
            </div>

            <!-- Attaquant / MITM -->
            <div
                id="node-attacker"
                class="node-card border-slate-800 bg-slate-950/60 hover:border-slate-700"
            >
                <div
                    id="attacker-icon-container"
                    class="w-14 h-14 mx-auto mb-3 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 transition-all duration-300"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.8"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        ></path></svg
                    >
                </div>
                <p
                    class="font-bold text-xs uppercase tracking-wider text-amber-400"
                >
                    Proxy Attaquant
                </p>
                <p class="text-[11px] font-mono text-slate-500 mt-1">
                    Faux certificat HTTPS
                </p>
            </div>

            <!-- Serveur Légitime -->
            <div
                id="node-server"
                class="node-card border-slate-800/30 bg-slate-950/20 opacity-30"
            >
                <div
                    class="w-14 h-14 mx-auto mb-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.8"
                            d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"
                        ></path></svg
                    >
                </div>
                <p
                    class="font-bold text-xs uppercase tracking-wider text-slate-500"
                >
                    Serveur Légitime
                </p>
                <p class="text-[11px] font-mono text-slate-600 mt-1">
                    Non sollicité
                </p>
            </div>
        </div>
    </div>

    <!-- Terminal de log -->
    <div
        class="relative z-10 mt-6 p-4 rounded-xl bg-slate-900/90 border border-slate-800 font-mono text-xs leading-relaxed"
    >
        <div
            class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3 text-slate-500"
        >
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                <span class="ml-2 text-slate-400">console.log</span>
            </div>
            <span id="log-step-tag" class="text-slate-600">STEP_1</span>
        </div>
        <p id="log-output" class="text-slate-300 min-h-[3rem] transition-all">
            Sélectionnez une étape ci-dessous pour analyser le flux d'attaque.
        </p>
    </div>

    <!-- Barres d'étapes -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-2 mt-6">
        <button data-step="1" class="step-btn">
            <span class="block text-[10px] text-slate-500 uppercase font-mono"
                >Étape 1</span
            >
            Reconstitution
        </button>
        <button data-step="2" class="step-btn">
            <span class="block text-[10px] text-slate-500 uppercase font-mono"
                >Étape 2</span
            >
            Interception
        </button>
        <button data-step="3" class="step-btn">
            <span class="block text-[10px] text-slate-500 uppercase font-mono"
                >Étape 3</span
            >
            Injection
        </button>
        <button data-step="4" class="step-btn">
            <span class="block text-[10px] text-slate-500 uppercase font-mono"
                >Étape 4</span
            >
            Exécution
        </button>
    </div>
</div>

<style>
    .node-card {
        padding: 1.25rem;
        border-radius: 0.85rem;
        border-width: 1px;
        transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .step-btn {
        padding: 0.6rem 0.75rem;
        background-color: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(30, 41, 59, 0.8);
        color: rgb(203, 213, 225);
        font-size: 0.75rem;
        font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        border-radius: 0.6rem;
        transition: all 200ms ease;
        text-align: left;
        font-weight: 500;
        cursor: pointer;
    }

    .step-btn:hover {
        background-color: rgba(30, 41, 59, 0.9);
        border-color: rgba(71, 85, 105, 0.8);
    }

    .step-btn.active {
        background-color: rgba(30, 58, 138, 0.2);
        border-color: rgb(59, 130, 246);
        color: rgb(147, 197, 253);
        box-shadow: 0 0 12px rgba(59, 130, 246, 0.15);
    }

    /* Animations SVG pour les flux de données */
    .line-active {
        stroke: #f59e0b !important;
        stroke-dasharray: 6;
        animation: flow 0.8s linear infinite;
    }

    .line-danger {
        stroke: #ef4444 !important;
        stroke-dasharray: 6;
        animation: flow 0.4s linear infinite;
    }

    @keyframes flow {
        to {
            stroke-dashoffset: -12;
        }
    }
</style>

<script>
    interface StepData {
        id: number;
        badge: string;
        log: string;
        carText: string;
        carBadgeStyle: string;
        lineClass: string;
        carIconStyle: string;
    }

    const steps: StepData[] = [
        {
            id: 1,
            badge: "1 / 4 — Trafic Initial",
            log: "> [OUTBOUND] Le véhicule émet une requête HTTP standard via le réseau GSM vers les serveurs BMW.",
            carText: "Verrouillé",
            carBadgeStyle: "bg-red-500/10 text-red-400 border-red-500/20",
            lineClass: "",
            carIconStyle: "bg-blue-500/10 border-blue-500/30 text-blue-400",
        },
        {
            id: 2,
            badge: "2 / 4 — Interception",
            log: "> [MITM_DETECTED] L'attaquant simule une antenne ou un routeur intermédiaire. Le client accepte le certificat invalide sans contrôle de révocation.",
            carText: "Connexion MITM",
            carBadgeStyle: "bg-amber-500/10 text-amber-400 border-amber-500/20",
            lineClass: "line-active",
            carIconStyle: "bg-amber-500/10 border-amber-500/30 text-amber-400",
        },
        {
            id: 3,
            badge: "3 / 4 — Injection Payload",
            log: '> [PAYLOAD_INJECTED] Trame forgée transmise : "SERVICE_DOOR_UNLOCK_REQ". Absence d\'authentification HMAC sur la charge utile.',
            carText: "Lecture de la trame...",
            carBadgeStyle:
                "bg-amber-500/10 text-amber-400 border-amber-500/20 animate-pulse",
            lineClass: "line-danger",
            carIconStyle: "bg-amber-500/10 border-amber-500/30 text-amber-400",
        },
        {
            id: 4,
            badge: "4 / 4 — Compromission",
            log: "> [EXPLOIT_SUCCESS] La commande de déverrouillage est acceptée par le bus CAN. Portes déverrouillées.",
            carText: "Déverrouillé !",
            carBadgeStyle:
                "bg-emerald-500/10 text-emerald-400 border-emerald-500/30 font-bold",
            lineClass: "",
            carIconStyle:
                "bg-emerald-500/10 border-emerald-500/30 text-emerald-400 scale-110",
        },
    ];

    let currentStep = 1;
    let autoplayInterval: NodeJS.Timeout | null = null;

    const buttons = document.querySelectorAll<HTMLButtonElement>(".step-btn");
    const logOutput = document.getElementById("log-output");
    const logStepTag = document.getElementById("log-step-tag");
    const statusBadge = document.getElementById("status-badge");
    const carState = document.getElementById("car-state");
    const carIconContainer = document.getElementById("car-icon-container");
    const lineCarAttacker = document.getElementById("line-car-attacker");
    const btnAutoplay = document.getElementById("btn-autoplay");
    const playIcon = document.getElementById("play-icon");

    function setStep(stepNumber: number) {
        currentStep = stepNumber;
        const data = steps.find((s) => s.id === stepNumber);
        if (!data) return;

        // Mise à jour boutons
        buttons.forEach((btn) => {
            const active = btn.getAttribute("data-step") === String(stepNumber);
            btn.classList.toggle("active", active);
        });

        // Console et badges
        if (logOutput) logOutput.textContent = data.log;
        if (logStepTag) logStepTag.textContent = `STEP_${data.id}`;
        if (statusBadge) statusBadge.textContent = data.badge;

        // État du véhicule
        if (carState) {
            carState.textContent = data.carText;
            carState.className = `inline-block mt-2 px-2.5 py-0.5 rounded text-[11px] font-mono border transition-all ${data.carBadgeStyle}`;
        }

        if (carIconContainer) {
            carIconContainer.className = `w-14 h-14 mx-auto mb-3 rounded-xl border flex items-center justify-center transition-all duration-300 ${data.carIconStyle}`;
        }

        // Animation SVG
        if (lineCarAttacker) {
            lineCarAttacker.setAttribute(
                "class",
                `stroke-slate-700 transition-all duration-300 ${data.lineClass}`,
            );
        }
    }

    function toggleAutoplay() {
        if (autoplayInterval) {
            clearInterval(autoplayInterval);
            autoplayInterval = null;
            if (playIcon) playIcon.textContent = "▶";
            if (btnAutoplay) btnAutoplay.classList.remove("bg-blue-500/30");
        } else {
            if (playIcon) playIcon.textContent = "⏸";
            if (btnAutoplay) btnAutoplay.classList.add("bg-blue-500/30");
            autoplayInterval = setInterval(() => {
                const nextStep = (currentStep % steps.length) + 1;
                setStep(nextStep);
            }, 2500);
        }
    }

    // Événements
    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            if (autoplayInterval) toggleAutoplay(); // Stopper le mode auto en cas de clic
            const step = Number(btn.getAttribute("data-step"));
            setStep(step);
        });
    });

    btnAutoplay?.addEventListener("click", toggleAutoplay);

    // Étape initiale
    setStep(1);
</script>
