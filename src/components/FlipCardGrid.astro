---

interface GlossaryCard {
  type: "glossaire";
  front: string;
  back: string;
}

interface StepCard {
  type: "etape";
  step: number;
  front: string;
  back: string;
}

export type FlipCard = GlossaryCard | StepCard;

interface Props {
  cards: FlipCard[];
}

const { cards } = Astro.props;

// Séparer glossaire et étapes, trier les étapes par numéro
const glossaryCards = cards.filter((c): c is GlossaryCard => c.type === "glossaire");
const stepCards = cards
  .filter((c): c is StepCard => c.type === "etape")
  .sort((a, b) => a.step - b.step);
---

<section class="relative w-full py-8 [font-family:-apple-system,'Segoe_UI',system-ui,sans-serif]" aria-label="Jeu de cartes pédagogiques">
  <noscript>
    <p class="mx-auto mb-6 max-w-[700px] rounded-lg border border-[#f3e0b2] bg-[#fef3c7] px-4 py-3 text-center text-sm text-[#92400e]">
      Les cartes ci-dessous sont entièrement consultables.
      Pour activer l'animation de retournement, activez JavaScript dans votre navigateur.
    </p>
  </noscript>

  {/* ── SVG Defs partagées (textures) ── */}
  <svg class="absolute h-0 w-0 overflow-hidden pointer-events-none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="flipcard-texture" width="4" height="4" patternTransform="scale(2.5)" patternUnits="userSpaceOnUse">
        <path fill="#000000" d="M1 3h1v1H1V3zm2-2h1v1H3V1z"></path>
      </pattern>
      <pattern id="flipcard-back-pattern-blue" width="20" height="20" patternTransform="rotate(30) scale(1.2)" patternUnits="userSpaceOnUse">
        <rect width="100%" height="100%" fill="#e8f0fe"/>
        <circle cx="10" cy="10" r="1.5" fill="#2F6FED" opacity="0.15"/>
        <circle cx="0" cy="0" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="20" cy="0" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="0" cy="20" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="20" cy="20" r="1.5" fill="#2F6FED" opacity="0.1"/>
      </pattern>
      <pattern id="flipcard-back-pattern-amber" width="20" height="20" patternTransform="rotate(-15) scale(1.2)" patternUnits="userSpaceOnUse">
        <rect width="100%" height="100%" fill="#fef7e6"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.18" d="M0 10 Q5 5, 10 10 Q15 15, 20 10"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.12" d="M0 0 Q5 -5, 10 0 Q15 5, 20 0"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.12" d="M0 20 Q5 15, 10 20 Q15 25, 20 20"/>
      </pattern>
    </defs>
  </svg>

  {/* ── Étapes ── */}
  {stepCards.length > 0 && (
    <div class="mb-9">
      <h3 class="mb-[18px] flex items-center gap-2 text-xl font-bold tracking-[-0.01em] text-[#101828]">
        Étapes de l'attaque
      </h3>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
        {stepCards.map((card) => (
          <button
            type="button"
            class="group block w-full cursor-pointer select-none appearance-none border-0 bg-transparent p-0 text-left [aspect-ratio:3/4] [font:inherit] [perspective:900px] [-webkit-tap-highlight-color:transparent] [filter:drop-shadow(0_4px_12px_rgba(16,24,40,0.08))] transition-[filter] duration-200 ease-in-out hover:[filter:drop-shadow(0_12px_28px_rgba(16,24,40,0.16))] focus-visible:rounded-2xl focus-visible:outline-[3px] focus-visible:outline-[#2F6FED] focus-visible:outline-offset-4"
            data-flipcard
            aria-pressed="false"
          >
            <div class="relative h-full w-full [transform-style:preserve-3d] [will-change:transform] [transition:transform_0.75s_linear(0,0.008_1.1%,0.031_2.2%,0.129_4.8%,0.257_7.2%,0.671_14.2%,0.789_16.5%,0.881_18.6%,0.957_20.7%,1.019_22.9%,1.063_25.1%,1.094_27.4%,1.114_30.7%,1.112_34.5%,1.018_49.9%,0.99_59.1%,1)] hover:[transform:scale(1.04)_rotate3d(1,1,0,2deg)] aria-[pressed=true]:[transform:rotateY(180deg)] aria-[pressed=true]:hover:[transform:rotateY(180deg)_scale(1.04)_rotate3d(1,1,0,2deg)] motion-reduce:[transform:none] motion-reduce:transition-none">
              {/* RECTO */}
              <div class="absolute inset-0 z-[2] flex flex-col items-center justify-center gap-2.5 overflow-hidden rounded-2xl bg-white px-[18px] py-6 [backface-visibility:hidden] motion-reduce:[backface-visibility:visible] motion-reduce:transition-opacity motion-reduce:duration-300 group-aria-[pressed=true]:motion-reduce:pointer-events-none group-aria-[pressed=true]:motion-reduce:opacity-0">
                <svg
                  class="absolute inset-0 z-0 h-full w-full rounded-[15px] pointer-events-none"
                  viewBox="0 0 252 346"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <defs>
                    <clipPath id={`step-card-clip-${card.step}`}>
                      <rect width="252" height="346" rx="15" />
                    </clipPath>
                  </defs>
                  <g clip-path={`url(#step-card-clip-${card.step})`}>
                    <rect width="252" height="346" fill="#FFFFFF" />
                  <path
                    d="M49.4993 300C13.8993 318.4 3.33261 379 12.4993 390C97.4993 453 305.9 523.6 285.5 470C265.1 416.4 309.666 266 334.5 197.5C320.333 202 362.401 147.633 307.5 139.5C226.5 127.5 248.5 188.5 194 208.5C139.5 228.5 172 272 145 294.5C114 320.333 93.9993 277 49.4993 300Z"
                    fill="#A6C4FF"
                    fill-opacity="0.41"
                  />
                  <path
                    d="M231.216 54.9724C266.816 36.5724 277.382 -24.0276 268.216 -35.0276C183.216 -98.0276 -25.1847 -168.628 -4.78467 -115.028C15.6153 -61.4276 -28.9513 88.9724 -53.7847 157.472C-39.618 152.972 -81.6859 207.339 -26.7852 215.472C54.2148 227.473 4 177.472 58.5 157.472C113 137.473 67.9688 76.7863 125 47.5C162 28.5 186.716 77.9724 231.216 54.9724Z"
                    fill="#A6C4FF"
                  />
                  </g>
                </svg>
                <span class="absolute left-1/2 top-[32%] z-[1] -translate-x-1/2 text-[clamp(48px,5vw,70px)] font-bold leading-none text-[#a6c4ff]">{card.step}</span>
                <span class="absolute left-1/2 top-[55%] z-[1] -translate-x-1/2 whitespace-nowrap text-[clamp(15px,1.7vw,22px)] font-bold uppercase leading-none text-[#a6c4ff]">Étape</span>
                <span class="mt-auto inline-flex items-center gap-[5px] pt-1 text-[11px] italic text-[#6b7280] opacity-70 transition-opacity duration-200 group-hover:opacity-100 group-aria-[pressed=true]:invisible">
                  <svg class="opacity-60" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  Retourner
                </span>
              </div>
              {/* VERSO */}
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 overflow-hidden rounded-2xl border-[5px] border-[#a6c4ff] bg-white px-[18px] py-6 text-[#86aaf2] [backface-visibility:hidden] [transform:rotateY(180deg)] motion-reduce:[backface-visibility:visible] motion-reduce:[transform:none] motion-reduce:opacity-0 motion-reduce:transition-opacity motion-reduce:duration-300 group-aria-[pressed=true]:motion-reduce:opacity-100">
                <span class="relative z-[1] text-[clamp(42px,4vw,58px)] font-extrabold leading-[0.9] text-[#a6c4ff]">{card.step}</span>
                <span class="relative z-[1] -mt-0.5 text-[clamp(13px,1.4vw,18px)] font-extrabold uppercase text-[#a6c4ff]">Étape</span>
                <span class="relative z-[1] mt-2 max-w-[90%] text-center text-sm leading-[1.6] text-[#46679f]">{card.back}</span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}

  {/* ── Glossaire ── */}
  {glossaryCards.length > 0 && (
    <div class="mb-9">
      <h3 class="mb-[18px] flex items-center gap-2 text-xl font-bold tracking-[-0.01em] text-[#101828]">
        Glossaire
      </h3>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
        {glossaryCards.map((card) => (
          <button
            type="button"
            class="group block w-full cursor-pointer select-none appearance-none border-0 bg-transparent p-0 text-left [aspect-ratio:3/4] [font:inherit] [perspective:900px] [-webkit-tap-highlight-color:transparent] [filter:drop-shadow(0_4px_12px_rgba(16,24,40,0.08))] transition-[filter] duration-200 ease-in-out hover:[filter:drop-shadow(0_12px_28px_rgba(16,24,40,0.16))] focus-visible:rounded-2xl focus-visible:outline-[3px] focus-visible:outline-[#2F6FED] focus-visible:outline-offset-4"
            data-flipcard
            aria-pressed="false"
          >
            <div class="relative h-full w-full [transform-style:preserve-3d] [will-change:transform] [transition:transform_0.75s_linear(0,0.008_1.1%,0.031_2.2%,0.129_4.8%,0.257_7.2%,0.671_14.2%,0.789_16.5%,0.881_18.6%,0.957_20.7%,1.019_22.9%,1.063_25.1%,1.094_27.4%,1.114_30.7%,1.112_34.5%,1.018_49.9%,0.99_59.1%,1)] hover:scale-[1.04] hover:[transform:rotate3d(1,1,0,2deg)] aria-[pressed=true]:[transform:rotateY(180deg)] aria-[pressed=true]:hover:scale-[1.04] aria-[pressed=true]:hover:[transform:rotateY(180deg)_rotate3d(1,1,0,2deg)] motion-reduce:transform-none motion-reduce:transition-none">
              {/* RECTO */}
              <div class="absolute inset-0 z-[2] flex flex-col items-center justify-center gap-2.5 overflow-hidden rounded-2xl bg-white px-[18px] py-6 [backface-visibility:hidden]">
                <svg
                  class="absolute inset-0 z-0 h-full w-full rounded-[15px] pointer-events-none"
                  viewBox="0 0 252 346"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <defs>
                    <clipPath id={`glossary-card-clip-${card.front}`}>
                      <rect width="252" height="346" rx="15" />
                    </clipPath>
                  </defs>
                  <g clip-path={`url(#glossary-card-clip-${card.front})`}>
                    <rect width="252" height="346" fill="#FFFFFF" />
                    <path
                      d="M49.4993 300C13.8993 318.4 3.33261 379 12.4993 390C97.4993 453 305.9 523.6 285.5 470C265.1 416.4 309.666 266 334.5 197.5C320.333 202 362.401 147.633 307.5 139.5C226.5 127.5 248.5 188.5 194 208.5C139.5 228.5 172 272 145 294.5C114 320.333 93.9993 277 49.4993 300Z"
                      fill="#0BA5B7"
                      fill-opacity="0.24"
                    />
                    <path
                      d="M231.216 54.9724C266.816 36.5724 277.382 -24.0276 268.216 -35.0276C183.216 -98.0276 -25.1847 -168.628 -4.78467 -115.028C15.6153 -61.4276 -28.9513 88.9724 -53.7847 157.472C-39.618 152.972 -81.6859 207.339 -26.7852 215.472C54.2148 227.473 4 177.472 58.5 157.472C113 137.473 67.9688 76.7863 125 47.5C162 28.5 186.716 77.9724 231.216 54.9724Z"
                      fill="#107AA5"
                      fill-opacity="0.46"
                    />
                  </g>
                </svg>
                <span class="absolute left-1/2 top-1/2 z-[1] w-[calc(100%-32px)] -translate-x-1/2 -translate-y-1/2 text-center text-[20px] font-bold leading-[1.3] text-[#107aa5]">{card.front}</span>
                <span class="mt-auto inline-flex items-center gap-[5px] pt-1 text-[11px] italic text-[#6b7280] opacity-70 transition-opacity duration-200 group-hover:opacity-100 group-aria-[pressed=true]:invisible">
                  <svg class="opacity-60" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  Retourner
                </span>
              </div>
              {/* VERSO */}
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 overflow-hidden rounded-2xl border-[5px] border-[#107aa5] bg-white px-[18px] py-6 text-[#107aa5] [backface-visibility:hidden] [transform:rotateY(180deg)]">
                <span class="text-center text-[15px] font-bold leading-[1.2] text-[#107aa5]">{card.front}</span>
                <span class="text-center text-sm leading-[1.6] text-[#101828]">{card.back}</span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}
</section>

<script>
  // Interactivité des cartes — retournement au clic / clavier
  function initFlipCards() {
    const cards = document.querySelectorAll<HTMLButtonElement>("[data-flipcard]");

    cards.forEach((card) => {
      // Guard against double-binding when Astro view transitions re-fire
      if (card.dataset.flipcardBound) return;
      card.dataset.flipcardBound = "1";

      function toggle() {
        const isFlipped = card.getAttribute("aria-pressed") === "true";
        const inner = card.firstElementChild as HTMLElement | null;
        const nextIsFlipped = !isFlipped;

        card.setAttribute("aria-pressed", String(nextIsFlipped));
        if (inner) {
          inner.style.transform = nextIsFlipped ? "rotateY(180deg)" : "";
        }
      }

      card.addEventListener("click", toggle);

      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  }

  // S'exécute quand le DOM est prêt (compatible Astro view transitions)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFlipCards);
  } else {
    initFlipCards();
  }

  // Support Astro view transitions (si activées)
  document.addEventListener("astro:page-load", initFlipCards);
</script>
