---
const navItems = [
    { id: "introduction", label: "Introduction" },
    { id: "cas-1", label: "Cas 1" },
    { id: "cas-2", label: "Cas 2" },
    { id: "cas-3", label: "Cas 3" },
    { id: "cas-4", label: "Cas 4" },
    { id: "synthese", label: "Synthèse" },
];
---

<div class="menu w-70 mr-0">
    <aside class="sidebar w-70" aria-label="Navigation du parcours">
        <div class="brand-logos">
            <img
                src="src/assets/cymove2.svg"
                alt="Logo CyMove"
                width="75%"
                height="auto"
                loading="eager"
            />
            <img
                src="src/assets/pôlevéhiculedufutur.svg"
                alt="Logo Pôle Véhicule du Futur"
                width="75%"
                height="auto"
                loading="eager"
            />
        </div>

        <span class="brand-text">
            <strong>Acculturation</strong><br />
            <strong>Cybersécurité</strong><br />
            <small>Module interactif 4HFactory</small>
        </span>

        <nav class="desktop-nav" aria-label="Sommaire principal">
            {
                navItems.map((item) => (
                    <a class="nav-link" href={`#${item.id}`}>
                        <span class="nav-dot" aria-hidden="true" />
                        <span class="nav-text">{item.label}</span>
                    </a>
                ))
            }
        </nav>
    </aside>
</div>

<header class="mobile-header">
    <div class="mobile-brand">
        <img
            src="src/assets/cymove2.svg"
            alt="Logo CyMove"
            width="40"
            height="auto"
        />
        <span class="brand-label">
            <strong>Acculturation</strong>
            <strong>Cybersécurité</strong>
        </span>
    </div>

    <details class="mobile-menu">
        <summary aria-label="Menu de navigation">
            <span class="hamburger-icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Sommaire mobile">
            {navItems.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        </nav>
    </details>
</header>

<script>
    // Gestion du ScrollSpy et de l'interactivité mobile
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
        ".desktop-nav .nav-link",
    );
    const mobileLinks =
        document.querySelectorAll<HTMLAnchorElement>(".mobile-menu nav a");
    const mobileMenu =
        document.querySelector<HTMLDetailsElement>(".mobile-menu");

    // Auto-fermeture du menu mobile lors de la sélection d'un lien
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            if (mobileMenu) mobileMenu.open = false;
        });
    });

    // Observer pour le défilement (ScrollSpy)
    const sections = Array.from(navLinks)
        .map((link) => {
            const id = link.getAttribute("href")?.substring(1);
            return id ? document.getElementById(id) : null;
        })
        .filter((section): section is HTMLElement => section !== null);

    if (sections.length > 0) {
        const observerOptions = {
            root: null,
            rootMargin: "-20% 0px -60% 0px",
            threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const activeId = entry.target.id;
                    let pastActive = false;

                    navLinks.forEach((link) => {
                        const href = link.getAttribute("href")?.substring(1);
                        if (href === activeId) {
                            link.classList.add("active");
                            link.classList.remove("past");
                            link.setAttribute("aria-current", "location");
                            pastActive = true;
                        } else if (!pastActive) {
                            link.classList.add("past");
                            link.classList.remove("active");
                            link.removeAttribute("aria-current");
                        } else {
                            link.classList.remove("active", "past");
                            link.removeAttribute("aria-current");
                        }
                    });
                }
            });
        }, observerOptions);

        sections.forEach((section) => observer.observe(section));
    }
</script>

<style>
    :global(*) {
        box-sizing: border-box;
    }
    :global(:root) {
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            sans-serif;
        color: #071a27;
        background: #effbfe;
        font-synthesis: none;
    }
    :global(html) {
        scroll-behavior: smooth;
    }
    :global(body) {
        margin: 0;
        min-width: 320px;
        background: #effbfe;
    }

    /* Layout principal */
    .sidebar {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 28px 20px 28px 24px;
        color: #0b6287;
        overflow-y: auto;
        margin-right: 0;
    }

    .brand-logos {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
    }

    .brand-text {
        font-size: 25px;
        line-height: 1.35;
        color: #07283a;
    }

    /* Sommaire Desktop & Barre de progression */
    .desktop-nav {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 28px;
        margin: 36px 0 0 12px;
        padding-left: 24px;
    }

    .nav-link {
        position: relative;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: #5c99ae;
        outline: none;
        transition: color 0.2s ease;
        z-index: 2;
    }

    .nav-link:focus-visible {
        outline: 2px solid #0f739c;
        outline-offset: 4px;
        border-radius: 4px;
    }

    .nav-text {
        font-size: 15px;
        font-weight: 700;
        line-height: 1.2;
        transition:
            font-size 0.2s ease,
            color 0.2s ease;
    }

    /* Puce inactive */
    .nav-dot {
        position: absolute;
        left: -24px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #89bece;
        transform: translateX(-50%);
        transition:
            background-color 0.2s ease,
            width 0.2s ease,
            height 0.2s ease;
    }

    /* Segment vertical de progression */
    .nav-link::after {
        content: "";
        position: absolute;
        left: -24px;
        top: -34px;
        height: 38px;
        width: 4px;
        background: #0f739c;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.2s ease;
        z-index: 1;
    }

    .nav-link:first-child::after {
        display: none;
    }

    /* États Actif & Passé */
    .nav-link.active .nav-text {
        color: #0f739c;
        font-size: 22px;
        font-weight: 800;
    }

    .nav-link.active .nav-dot {
        width: 14px;
        height: 14px;
        background: #0f739c;
    }

    .nav-link.active::after,
    .nav-link.past::after {
        opacity: 1;
    }

    .nav-link.past .nav-dot {
        background: #0f739c;
    }

    .nav-link.past .nav-text {
        color: #5c99ae;
    }

    .nav-link:hover .nav-text {
        color: #0f739c;
    }

    /* Pied de sidebar */
    .sidebar-line {
        width: 100%;
        height: 1px;
        margin-top: auto;
        padding-top: 24px;
        border-bottom: 1px solid #b8e5f1;
    }

    .sidebar-note {
        margin: 14px 0 0;
        color: #5c99ae;
        font-size: 11px;
        line-height: 1.5;
    }

    /* Header Mobile */
    .mobile-header {
        display: none;
    }

    @media (max-width: 900px) {
        .sidebar {
            display: none;
        }

        .mobile-header {
            position: sticky;
            z-index: 100;
            top: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 64px;
            padding: 12px 20px;
            border-bottom: 1px solid rgba(129, 206, 226, 0.4);
            background: rgba(239, 251, 254, 0.92);
            backdrop-filter: blur(12px);
        }

        .mobile-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-label {
            font-size: 12px;
            line-height: 1.2;
            color: #07283a;
        }

        .mobile-menu {
            position: relative;
        }

        .mobile-menu summary {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            list-style: none;
            cursor: pointer;
            border-radius: 8px;
            background: rgba(184, 229, 241, 0.3);
        }

        .mobile-menu summary::-webkit-details-marker {
            display: none;
        }

        .hamburger-icon,
        .hamburger-icon::before,
        .hamburger-icon::after {
            display: block;
            width: 18px;
            height: 2px;
            border-radius: 2px;
            background: #087da5;
            position: relative;
            transition: background 0.2s ease;
        }

        .hamburger-icon::before,
        .hamburger-icon::after {
            content: "";
            position: absolute;
            left: 0;
        }

        .hamburger-icon::before {
            top: -6px;
        }

        .hamburger-icon::after {
            top: 6px;
        }

        .mobile-menu nav {
            position: absolute;
            right: 0;
            top: 48px;
            display: flex;
            flex-direction: column;
            width: 200px;
            padding: 8px;
            border: 1px solid #b7e2ed;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 12px 28px rgba(7, 40, 58, 0.12);
        }

        .mobile-menu nav a {
            padding: 12px 14px;
            color: #0b6287;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 6px;
            transition: background-color 0.15s ease;
        }

        .mobile-menu nav a:hover,
        .mobile-menu nav a:focus-visible {
            background: #effbfe;
            color: #0f739c;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
        }
        .nav-link,
        .nav-text,
        .nav-dot,
        .nav-link::after {
            transition: none !important;
        }
    }

    .brand-text small {
        font-size: 15px;
        color: #0b6287;
        opacity: 0.85;
        line-height: -1000;
    }
</style>
